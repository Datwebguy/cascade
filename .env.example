# Buffer OAuth App Client (register at https://publish.buffer.com/settings/api)
BUFFER_CLIENT_ID=
# Only for confidential clients. Leave empty for a public (PKCE-only) client.
BUFFER_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Buffer.
BUFFER_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32+ random characters used to encrypt the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
