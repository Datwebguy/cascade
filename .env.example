# --- Buffer App Client (Settings -> API -> App Clients -> New Client, choose Private) ---
BUFFER_CLIENT_ID=
# Private (confidential) client secret. Set it only in your host's secret settings; never commit it.
BUFFER_CLIENT_SECRET=
# Must match a redirect URI registered on the client, character for character. HTTPS is required,
# including localhost. Local dev (`npm run dev` serves HTTPS):
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/callback

# --- Session ---
# 32+ random characters. Generate with: openssl rand -hex 32  (use a different value per environment)
SESSION_SECRET=

# --- Token & cache store (Upstash Redis REST; Vercel's Redis/KV integration sets these) ---
# Required in production. Leave empty for local development (an in-memory store is used).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI adaptation (OpenAI) ---
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=
